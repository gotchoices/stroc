{
  "name": "stroc-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @stroc/core build && yarn workspace @stroc/ui build && yarn workspace @stroc/server dev",
