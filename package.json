{
  "name": "stroc-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @stroc/core build && yarn workspace @stroc/ui build && yarn workspace @stroc/server dev",
    "build": "yarn workspaces foreach -A run build",
    "lint": "eslint .",
    "test": "yarn workspaces foreach -A run test",
    "start": "yarn build && yarn workspace @stroc/server start"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@stroc/cli": "workspace:*",
    "@types/node": "^20.12.12",
    "eslint": "^9",
    "typescript-eslint": "^8"
  },
  "type": "module"
}
