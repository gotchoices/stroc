{
  "name": "stroc-monorepo",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn build && yarn stroc serve contracts --watch --editor",
    "build": "yarn workspaces foreach -A run build",
    "lint": "eslint .",
    "test": "yarn workspaces foreach -A run test",
    "start": "yarn build && yarn stroc serve contracts",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release.mjs check",
    "release:version": "node scripts/release.mjs version",
    "release:publish": "node scripts/release.mjs publish"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "1.61.1",
    "@stroc/cli": "workspace:*",
    "@types/node": "^20.12.12",
    "eslint": "^9",
    "typescript-eslint": "^8"
  },
  "type": "module",
  "packageManager": "yarn@4.12.0"
}
