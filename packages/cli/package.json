{
  "name": "@stroc/cli",
  "version": "0.2.0",
  "description": "The stroc command: lint, CIDs, rendering, serving and folder maintenance for Stroc documents",
  "keywords": [
    "stroc",
    "structured-documents",
    "cli"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "bin": {
    "stroc": "dist/src/index.js"
  },
  "files": [
    "dist/src/**/*"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/src/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@stroc/compose": "workspace:*",
    "@stroc/core": "workspace:*",
    "@stroc/pdf": "workspace:*",
    "@stroc/render": "workspace:*",
    "@stroc/server": "workspace:*",
    "@stroc/yaml": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
