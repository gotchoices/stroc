{
  "name": "@stroc/compose",
  "version": "0.0.1",
  "description": "Fetch, verify and compose Stroc documents and their includes; HTTP resolver and catalogs",
  "keywords": [
    "stroc",
    "structured-documents",
    "ipfs",
    "trustless-gateway"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/compose#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/compose"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@stroc/core": "workspace:*",
    "multiformats": "^11.0.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
