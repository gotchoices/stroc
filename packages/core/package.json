{
  "name": "@stroc/core",
  "version": "0.2.0",
  "description": "Stroc structured documents: types, validation, canonical DAG-JSON encoding and CIDs",
  "keywords": [
    "stroc",
    "structured-documents",
    "legal",
    "contracts",
    "documents",
    "ipld",
    "cid",
    "dag-json"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "module": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./markup": {
      "types": "./dist/src/markup.d.ts",
      "import": "./dist/src/markup.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@ipld/dag-json": "^10.2.0",
    "@noble/hashes": "^2",
    "multiformats": "^13.4 || ^14"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "files": [
    "dist/src/**/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
