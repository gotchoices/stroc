{
  "name": "@stroc/pdf",
  "version": "0.3.0",
  "description": "Write Stroc documents as PDF in Node, with embedded Noto fonts",
  "keywords": [
    "stroc",
    "structured-documents",
    "pdf",
    "pdfmake"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/pdf#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/pdf"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-mono": "^0.4",
    "@expo-google-fonts/noto-serif": "^0.4",
    "@stroc/render": "workspace:*",
    "pdfmake": "^0.3"
  },
  "devDependencies": {
    "@stroc/compose": "workspace:*",
    "@stroc/core": "workspace:*",
    "@stroc/yaml": "workspace:*",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
