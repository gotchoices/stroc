{
  "name": "@stroc/render",
  "version": "0.0.1",
  "description": "Lay out composed Stroc documents for HTML and PDF (pdfmake document definitions)",
  "keywords": [
    "stroc",
    "structured-documents",
    "render",
    "html",
    "pdf"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/render#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/render"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@stroc/compose": "workspace:*",
    "@stroc/core": "workspace:*",
    "qrcode-generator": "^1"
  },
  "devDependencies": {
    "@stroc/yaml": "workspace:*",
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
