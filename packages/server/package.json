{
  "name": "@stroc/server",
  "version": "0.2.0",
  "description": "Serve a folder of Stroc documents: IPFS trustless-gateway paths, a catalog and readable pages",
  "keywords": [
    "stroc",
    "structured-documents",
    "server",
    "ipfs",
    "gateway"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./args": {
      "types": "./dist/src/args.d.ts",
      "import": "./dist/src/args.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stroc-server": "dist/src/bin.js"
  },
  "files": [
    "dist/src/**/*",
    "public"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/src/bin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@stroc/compose": "workspace:*",
    "@stroc/core": "workspace:*",
    "@stroc/render": "workspace:*",
    "@stroc/ui": "workspace:*",
    "@stroc/yaml": "workspace:*",
    "express": "^4.19.2",
    "multiformats": "^13.4 || ^14",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
