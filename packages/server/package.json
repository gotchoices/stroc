{
  "name": "@stroc/server",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stroc-server": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "public"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/src/bin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@stroc/compose": "workspace:*",
    "@stroc/core": "workspace:*",
    "@stroc/render": "workspace:*",
    "@stroc/ui": "workspace:*",
    "@stroc/yaml": "workspace:*",
    "express": "^4.19.2",
    "multiformats": "^11.0.2",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.0",
    "vitest": "^3"
  }
}
