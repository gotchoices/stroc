{
  "name": "@stroc/yaml",
  "version": "0.1.0",
  "description": "Read, lint, fix and write Stroc documents in YAML",
  "keywords": [
    "stroc",
    "structured-documents",
    "yaml",
    "lint"
  ],
  "license": "MIT",
  "author": "Got Choices Foundation",
  "homepage": "https://github.com/gotchoices/stroc/tree/main/packages/yaml#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gotchoices/stroc.git",
    "directory": "packages/yaml"
  },
  "bugs": "https://github.com/gotchoices/stroc/issues",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@stroc/core": "workspace:*",
    "yaml": "^2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
